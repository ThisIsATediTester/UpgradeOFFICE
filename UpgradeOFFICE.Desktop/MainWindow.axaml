<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UpgradeOFFICE.Desktop.MainWindow"
        Title="UpgradeOFFICE"
        Width="1180" Height="780"
        MinWidth="820" MinHeight="580"
        Background="#F3F5F9"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Border Grid.Row="0" Background="#17243A" CornerRadius="18" Padding="24" Margin="0,0,0,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="7">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="#5D7CFA" CornerRadius="9" Padding="9,5">
              <TextBlock Text="UO" Foreground="White" FontSize="17" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="UpgradeOFFICE" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Seu espaço de trabalho, simples e organizado." FontSize="14" Foreground="#C8D3E4"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#263650" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
          <StackPanel Spacing="3">
            <TextBlock Text="EDIÇÃO DESKTOP" FontSize="10" FontWeight="Bold" Foreground="#AFC2FF"/>
            <TextBlock Text="Arquivos no seu computador" FontSize="12" Foreground="White"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="14">
      <TabControl>
        <TabItem Header="  Writer  ">
          <Grid RowDefinitions="Auto,Auto,*" Margin="12">
            <StackPanel Spacing="5" Margin="0,0,0,14">
              <TextBlock Text="Writer" FontSize="23" FontWeight="Bold" Foreground="#1B2940"/>
              <TextBlock Text="Escreva documentos e trabalhe com arquivos do Word (.docx) ou texto simples." FontSize="13" Foreground="#64748B"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
              <Border Background="#F3F6FB" CornerRadius="10" Padding="10">
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Abrir TXT" Click="OpenWriter_Click" Margin="0,0,8,0"/>
                  <Button Content="Salvar TXT" Click="SaveWriter_Click" Margin="0,0,8,0"/>
                  <Button Content="Abrir Word (.docx)" Click="OpenWord_Click" Margin="0,0,8,0"/>
                  <Button Content="Salvar Word (.docx)" Click="SaveWord_Click"/>
                </WrapPanel>
              </Border>
              <Border Background="#F8FAFC" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="10" Padding="8">
                <WrapPanel Orientation="Horizontal">
                  <Button Content="B" FontWeight="Bold" ToolTip.Tip="Negrito no parágrafo atual" Click="ToggleBold_Click" Margin="0,0,6,0"/>
                  <Button Content="I" FontStyle="Italic" ToolTip.Tip="Itálico no parágrafo atual" Click="ToggleItalic_Click" Margin="0,0,6,0"/>
                  <Button Content="U" ToolTip.Tip="Sublinhado no parágrafo atual (no Word salvo)" Click="ToggleUnderline_Click" Margin="0,0,12,0"/>
                  <TextBlock Text="Tamanho" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <ComboBox x:Name="WriterFontSize" Width="76" SelectedIndex="2" SelectionChanged="WriterFontSize_SelectionChanged" Margin="0,0,12,0">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="11"/>
                    <ComboBoxItem Content="12"/>
                    <ComboBoxItem Content="14"/>
                    <ComboBoxItem Content="16"/>
                    <ComboBoxItem Content="18"/>
                    <ComboBoxItem Content="24"/>
                    <ComboBoxItem Content="36"/>
                  </ComboBox>
                  <Button Content="Esquerda" Click="AlignLeft_Click" Margin="0,0,6,0"/>
                  <Button Content="Centro" Click="AlignCenter_Click" Margin="0,0,6,0"/>
                  <Button Content="Direita" Click="AlignRight_Click" Margin="0,0,6,0"/>
                  <Button Content="+ Parágrafo" Click="AddParagraph_Click"/>
                </WrapPanel>
              </Border>
            </StackPanel>
            <Border Grid.Row="2" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="10" Padding="12">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="WriterParagraphs" Spacing="8"/>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="  Sheets  ">
          <Grid RowDefinitions="Auto,Auto,*" Margin="12">
            <StackPanel Spacing="5" Margin="0,0,0,14">
              <TextBlock Text="Sheets" FontSize="23" FontWeight="Bold" Foreground="#1B2940"/>
              <TextBlock Text="Edite dados CSV em formato de texto, com colunas separadas por vírgulas." FontSize="13" Foreground="#64748B"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#F3F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Abrir CSV" Click="OpenSheet_Click"/>
                <Button Content="Salvar CSV" Click="SaveSheet_Click"/>
              </StackPanel>
            </Border>
            <Border Grid.Row="2" BorderBrush="#DCE3ED" BorderThickness="1" CornerRadius="10" Padding="8">
              <TextBox x:Name="SheetEditor" AcceptsReturn="True" TextWrapping="NoWrap"
                       FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Top"
                       Background="White" BorderThickness="0"
                       Watermark="Produto,Quantidade,Preço&#10;Caderno,3,12.50"/>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="  Slides  ">
          <Grid RowDefinitions="Auto,Auto,*" Margin="12">
            <StackPanel Spacing="5" Margin="0,0,0,14">
              <TextBlock Text="Slides" FontSize="23" FontWeight="Bold" Foreground="#1B2940"/>
              <TextBlock Text="Organize o título e o conteúdo de um rascunho de apresentação." FontSize="13" Foreground="#64748B"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#F3F6FB" CornerRadius="10" Padding="10" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Abrir rascunho" Click="OpenSlides_Click"/>
                <Button Content="Salvar rascunho" Click="SaveSlides_Click"/>
              </StackPanel>
            </Border>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,*" Margin="2,8">
              <TextBlock Text="Título do slide" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
              <TextBox x:Name="SlideTitle" Grid.Row="1" FontSize="16" Watermark="Digite o título"/>
              <TextBlock Grid.Row="2" Text="Conteúdo" FontWeight="SemiBold" Foreground="#334155" Margin="0,16,0,6"/>
              <TextBox x:Name="SlideBody" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                       FontSize="15" VerticalContentAlignment="Top"
                       Watermark="Escreva os pontos principais do slide"/>
            </Grid>
          </Grid>
        </TabItem>
      </TabControl>
    </Border>

    <Border Grid.Row="2" Background="#E7ECF4" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" Text="Pronto — seus arquivos são processados localmente." FontSize="12" Foreground="#526178" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="UpgradeOFFICE • Protótipo" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
